<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/workspace_card_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/custom_command_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F5F8FA"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/custom_command_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#8FA3B5"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/custom_command_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#B8C8D4"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/custom_command_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#0B1D29"
        android:fontFamily="monospace"
        android:maxLines="4"
        android:padding="10dp"
        android:textColor="#D8E4EC"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/custom_command_run"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/custom_commands_run"
            android:textAllCaps="false"
            android:textColor="#062118"
            android:backgroundTint="#68E0B7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/custom_command_manage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:text="@string/custom_commands_manage"
            android:textAllCaps="false"
            android:textColor="#D8E4EC"
            android:backgroundTint="#24394A" />
    </LinearLayout>
</LinearLayout>
