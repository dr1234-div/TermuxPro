<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/workspace_home_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="34dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/workspace_home_eyebrow"
            android:textAllCaps="true"
            android:textColor="#68E0B7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/workspace_home_title"
            android:textColor="#F5F8FA"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/workspace_home_subtitle"
            android:textColor="#9EB1C2"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/workspace_setup_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="@string/workspace_setup_action"
            android:textAllCaps="false"
            android:textColor="#D8E4EC"
            android:backgroundTint="#24394A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/workspace_card_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workspace_remote_card_title"
                android:textColor="#F5F8FA"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/workspace_remote_card_description"
                android:textColor="#8FA3B5"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/workspace_selector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#68E0B7"
                android:contentDescription="@string/workspace_selector_description" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workspace_new_button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/workspace_new_action"
                    android:textAllCaps="false"
                    android:textColor="#D8E4EC"
                    android:backgroundTint="#24394A" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workspace_save_button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/workspace_save_action"
                    android:textAllCaps="false"
                    android:textColor="#D8E4EC"
                    android:backgroundTint="#24394A" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workspace_delete_button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/workspace_delete_action"
                    android:textAllCaps="false"
                    android:textColor="#FFB4AB"
                    android:backgroundTint="#3B2930" />
            </LinearLayout>

            <EditText
                android:id="@+id/workspace_name_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#45627A"
                android:hint="@string/workspace_name_hint"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:textColor="#F5F8FA"
                android:textColorHint="#71879A" />

            <EditText
                android:id="@+id/workspace_host_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#45627A"
                android:hint="@string/workspace_host_hint"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#F5F8FA"
                android:textColorHint="#71879A" />

            <EditText
                android:id="@+id/workspace_port_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#45627A"
                android:hint="@string/workspace_port_hint"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="#F5F8FA"
                android:textColorHint="#71879A" />

            <EditText
                android:id="@+id/workspace_path_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#45627A"
                android:hint="@string/workspace_path_hint"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#F5F8FA"
                android:textColorHint="#71879A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/workspace_connect_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:text="@string/workspace_connect_action"
                android:textAllCaps="false"
                android:textColor="#062118"
                android:textStyle="bold"
                android:backgroundTint="#68E0B7" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/workspace_ai_quick_title"
            android:textColor="#F5F8FA"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/workspace_claude_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/workspace_start_claude"
                android:textAllCaps="false"
                android:textColor="#F5F8FA"
                android:backgroundTint="#25384A" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/workspace_codex_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/workspace_start_codex"
                android:textAllCaps="false"
                android:textColor="#F5F8FA"
                android:backgroundTint="#25384A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/workspace_card_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workspace_development_tools_title"
                android:textColor="#F5F8FA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/workspace_development_tools_description"
                android:textColor="#8FA3B5"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workspace_review_diff_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/workspace_review_diff_action"
                    android:textAllCaps="false"
                    android:textColor="#D8E4EC"
                    android:textSize="13sp"
                    android:backgroundTint="#24394A" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workspace_remote_files_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/workspace_remote_files_action"
                    android:textAllCaps="false"
                    android:textColor="#D8E4EC"
                    android:textSize="13sp"
                    android:backgroundTint="#24394A" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workspace_project_tasks_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/workspace_project_tasks_action"
                    android:textAllCaps="false"
                    android:textColor="#D8E4EC"
                    android:textSize="13sp"
                    android:backgroundTint="#24394A" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workspace_task_sessions_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/workspace_task_sessions_action"
                    android:textAllCaps="false"
                    android:textColor="#D8E4EC"
                    android:textSize="13sp"
                    android:backgroundTint="#24394A" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workspace_diagnostic_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/workspace_diagnostic_action"
                    android:textAllCaps="false"
                    android:textColor="#D8E4EC"
                    android:textSize="13sp"
                    android:backgroundTint="#24394A" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workspace_ssh_keys_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/workspace_ssh_keys_action"
                    android:textAllCaps="false"
                    android:textColor="#D8E4EC"
                    android:textSize="13sp"
                    android:backgroundTint="#24394A" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/workspace_card_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workspace_preview_title"
                android:textColor="#F5F8FA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/workspace_preview_description"
                android:textColor="#8FA3B5"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/workspace_remote_port_input"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:backgroundTint="#45627A"
                    android:hint="@string/workspace_remote_port_hint"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textColor="#F5F8FA"
                    android:textColorHint="#71879A" />

                <EditText
                    android:id="@+id/workspace_local_port_input"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="#45627A"
                    android:hint="@string/workspace_local_port_hint"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textColor="#F5F8FA"
                    android:textColorHint="#71879A" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workspace_start_preview_button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="@string/workspace_start_preview_action"
                    android:textAllCaps="false"
                    android:textColor="#062118"
                    android:backgroundTint="#68E0B7" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workspace_open_preview_button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/workspace_open_preview_action"
                    android:textAllCaps="false"
                    android:textColor="#D8E4EC"
                    android:backgroundTint="#24394A" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/workspace_local_terminal_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="@string/workspace_open_local_terminal"
            android:textAllCaps="false"
            android:textColor="#AFC1CF"
            android:backgroundTint="#162533" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/workspace_security_tip"
            android:textColor="#708496"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
