<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08131C"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="#111E2A"
        android:paddingHorizontal="10dp">
        <ImageButton
            android:id="@+id/task_sessions_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/git_diff_back"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/ic_arrow_back"
            app:tint="#AFC1CF" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="48dp"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:minWidth="0dp"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/task_sessions_title"
                android:textColor="#F5F8FA"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/task_sessions_refresh_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/git_diff_refresh"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_refresh"
            app:tint="#68E0B7" />
    </FrameLayout>
    <ProgressBar
        android:id="@+id/task_sessions_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true" />
    <TextView
        android:id="@+id/task_sessions_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:textColor="@color/tp_text_primary"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/task_sessions_safety_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:text="@string/task_sessions_safety_hint"
        android:textColor="@color/tp_text_secondary"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/task_sessions_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textColor="#AFC1CF"
        android:textSize="14sp" />
    <Button
        android:id="@+id/task_sessions_recovery_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:minHeight="48dp"
        android:text="@string/return_to_workspace"
        android:textAllCaps="false"
        android:textColor="@color/tp_on_primary"
        android:visibility="gone"
        app:backgroundTint="@color/tp_primary" />
    <Button
        android:id="@+id/task_sessions_create_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:minHeight="48dp"
        android:text="@string/task_sessions_create"
        android:textAllCaps="false"
        android:textColor="@color/tp_primary"
        app:backgroundTint="@color/tp_surface_elevated" />
    <ListView
        android:id="@+id/task_sessions_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#203444"
        android:dividerHeight="1dp"
        android:paddingHorizontal="8dp" />
</LinearLayout>
