<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08131C"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="#111E2A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageButton
            android:id="@+id/remote_file_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/git_diff_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#AFC1CF" />

        <TextView
            android:id="@+id/remote_file_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:gravity="center_vertical"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:textColor="#F5F8FA"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/remote_file_refresh_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/git_diff_refresh"
            android:src="@drawable/ic_refresh"
            app:tint="#68E0B7" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/remote_file_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <HorizontalScrollView
            android:id="@+id/remote_file_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/remote_file_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="360dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:padding="14dp"
                    android:textColor="#D8E4EC"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </ScrollView>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/remote_file_status_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/remote_file_status_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="#D8E4EC"
                android:textSize="16sp" />

            <Button
                android:id="@+id/remote_file_return_workspace_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="#68E0B7"
                android:minHeight="48dp"
                android:text="@string/return_to_workspace"
                android:textColor="#06231B"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
